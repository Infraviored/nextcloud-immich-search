{
    "name": "infraviored/glimpse",
    "description": "Nextcloud app: search photos by content and people, powered by Immich",
    "license": "AGPL-3.0-or-later",
    "type": "project",
    "autoload-dev": {
        "psr-4": {
            "OCA\\Glimpse\\": "lib/",
            "OCA\\Glimpse\\Tests\\": "tests/",
            "OCP\\": "vendor/nextcloud/ocp/OCP/",
            "NCU\\": "vendor/nextcloud/ocp/NCU/"
        }
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "nextcloud/coding-standard": "^1.5",
        "nextcloud/ocp": "dev-stable31",
        "phpunit/phpunit": "^10.5",
        "psr/log": "^3.0"
    },
    "config": {
        "platform": {
            "php": "8.1"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit -c tests/phpunit.xml",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "lint": "find lib tests appinfo templates -name '*.php' -print0 | xargs -0 -n1 php -l"
    }
}
